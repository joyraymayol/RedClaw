generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  REQUESTER
  TECHNICIAN
  ADMIN
  SUPERVISOR
  HEAD
}

enum AccountStatus {
  PENDING_PROFILE // mirrored from auth.users; profile form not yet submitted
  PENDING_APPROVAL // profile done; awaiting admin role assignment
  ACTIVE
  DISABLED
}

// Organizational department. Gates who may raise which ticket type and who
// may approve Machine-Setup tickets (Maintenance vs QA). Kept as an enum so
// authorization can rely on it — was previously free-text `String?`.
enum Department {
  PRODUCTION
  MAINTENANCE
  QUALITY_ASSURANCE
  WAREHOUSE
  ADMINISTRATION
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  PENDING_VERIFICATION
  PENDING_SUPERVISOR_REVIEW
  PENDING_MAINTENANCE_APPROVAL // Machine-Setup: awaiting Maintenance head/supervisor sign-off
  PENDING_QA_APPROVAL // Machine-Setup: awaiting QA head/supervisor sign-off
  REOPENED
  CLOSED
  CANCELLED
}

// The kind of work a ticket represents (distinct from TicketSource, which is
// origin). Drives creation gating, completion flow, and per-type UI.
enum TicketType {
  MAINTENANCE // unplanned repair/correction — the only type non-Maintenance staff may raise
  PREVENTIVE_MAINTENANCE // scheduled servicing with a per-machine checklist
  MACHINE_SETUP // mold change from a Production Plan; sequential Maintenance→QA approval
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketSource {
  MANUAL // raised by a requester
  PREVENTIVE // auto-generated by a MaintenanceSchedule
}

enum HoldReason {
  PREEMPTED_BY_HIGHER_PRIORITY
  WAITING_PARTS
  WAITING_VENDOR
  OTHER
  TEAM_REPLACED // system-set: updateAssignees fully swapped an IN_PROGRESS ticket's team
}

enum AssetStatus {
  OPERATIONAL
  DOWN
  UNDER_MAINTENANCE
  RETIRED
}

enum RemarkType {
  WORK_LOG
  GENERAL
  VERIFICATION_NOTE
}

enum AssignmentReason {
  INITIAL_ASSIGN
  REASSIGNED
  PREEMPTED_BY_HIGHER_PRIORITY
  RESUMED
  REOPENED
}

enum ScheduleFrequencyType {
  TIME // e.g. every 30 days
  USAGE // e.g. every 500 operating hours
}

// Lifecycle of a Production Plan. Prepared as DRAFT, submitted for approval,
// then APPROVED by any one designated approver (which freezes each row's
// "initial request" and lets Maintenance create Machine-Setup tickets).
enum ProductionPlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
}

// Kind of in-app notification — drives the bell icon/grouping. The title/body
// are rendered and denormalized at emit time so reads never re-join the source.
enum NotificationType {
  TICKET_ASSIGNED
  TICKET_UNASSIGNED
  TICKET_NEEDS_ASSIGNMENT // a new ticket awaiting triage/assignment (→ admins)
  TICKET_ON_HOLD // bumped to ON_HOLD by a higher-priority preempting assignment
  TICKET_RESOLVED
  TICKET_VERIFY_REQUESTED
  TICKET_REVIEW_REQUESTED
  TICKET_CLOSED
  TICKET_REOPENED
  TICKET_CANCELLED
  SETUP_MAINTENANCE_APPROVAL
  SETUP_QA_APPROVAL
  SETUP_REJECTED
  PLAN_APPROVAL_REQUESTED
  PLAN_APPROVED
  PLAN_ROW_CHANGED
}

model User {
  id         String        @id // = auth.users.id; supplied by the mirror trigger, never generated here
  email      String        @unique
  name       String // prefilled from Google metadata by the mirror trigger
  role       UserRole? // NULL until an admin approves and assigns one
  status     AccountStatus @default(PENDING_PROFILE)
  department Department?
  position   String?
  avatarUrl  String?
  isActive   Boolean       @default(false) // kept in sync with status; true only when ACTIVE
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  ticketsRaised      Ticket[]                  @relation("Requester")
  remarks            TicketRemark[]
  statusChanges      TicketStatusHistory[]
  assignmentsGiven   TicketAssignment[]        @relation("AssignedBy")
  assignmentsHeld    TicketAssignment[]        @relation("AssignedTechnician")
  solutionsAuthored  Solution[]
  partsLogged        TicketPart[]
  materialsLogged    TicketMaterialLog[]
  checklistChecked   TicketChecklistResult[]
  downtimeLogged     DowntimeLog[]
  usageReadings      AssetUsageLog[]
  productChanges     ProductChangeLog[]
  assetFlagsGiven    TicketAsset[]
  plansPrepared      ProductionPlan[]          @relation("PlanPreparedBy")
  plansApproved      ProductionPlan[]          @relation("PlanApprovedBy")
  planRowChanges     ProductionPlanRowChange[]
  planApprovership   ProductionPlanApprover?
  notifications      Notification[]            @relation("NotificationRecipient")
  notificationsActed Notification[]            @relation("NotificationActor")

  @@index([status])
}

// Products an asset is capable of running (Production Machines only, via
// AssetCategory.tracksProducts). CRUD `Product` catalog is shared across
// assets; `AssetProduct` is the per-asset capability list.
model Product {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "PET Small Bottle", "PET 2L Bottle"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  capabilities    AssetProduct[]
  currentOnAssets Asset[]             @relation("CurrentProduct")
  changeLogs      ProductChangeLog[]
  planRows        ProductionPlanRow[]
  setupTickets    Ticket[]            @relation("TicketTargetProduct")
}

// An asset's capability list — which products it *can* run, independent
// of which one it's currently set to (Asset.currentProductId).
model AssetProduct {
  id        String   @id @default(uuid())
  assetId   String
  productId String
  addedAt   DateTime @default(now())

  asset   Asset   @relation(fields: [assetId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([assetId, productId])
}

// Append-only changeover history — one row per Asset.currentProductId
// switch (productId null = cleared to no current product).
model ProductChangeLog {
  id          String   @id @default(uuid())
  assetId     String
  productId   String?
  changedById String
  changedAt   DateTime @default(now())

  asset     Asset    @relation(fields: [assetId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])
  changedBy User     @relation(fields: [changedById], references: [id])

  @@index([assetId, changedAt])
}

model AssetCategory {
  id                  String   @id @default(uuid())
  name                String   @unique // e.g. "Production Machines", "Machine Accessories"
  description         String?
  tracksProducts      Boolean  @default(false) // Production Machines: shows the Products card + changeover
  supportsParentAsset Boolean  @default(false) // Machine Accessories: offers a parent-asset picker
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  assets     Asset[]
  assetTypes AssetType[]
}

model AssetType {
  id         String @id @default(uuid())
  name       String // e.g. "PET Stretch Blow", "Chiller", "Forklift"
  categoryId String

  category AssetCategory @relation(fields: [categoryId], references: [id])
  assets   Asset[]

  @@unique([categoryId, name])
}

model Asset {
  id                String      @id @default(uuid())
  assetCode         String      @unique // e.g. "CNC-014"
  name              String
  categoryId        String
  typeId            String?
  location          String?
  status            AssetStatus @default(OPERATIONAL)
  serialNumber      String?
  manufacturer      String?
  model             String?
  purchaseDate      DateTime?
  installedAt       DateTime?
  commissionedAt    DateTime?
  warrantyExpiresAt DateTime?
  retiredAt         DateTime?
  parentAssetId     String?
  currentProductId  String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  category       AssetCategory @relation(fields: [categoryId], references: [id])
  type           AssetType?    @relation(fields: [typeId], references: [id])
  parentAsset    Asset?        @relation("AssetParent", fields: [parentAssetId], references: [id])
  childAssets    Asset[]       @relation("AssetParent")
  currentProduct Product?      @relation("CurrentProduct", fields: [currentProductId], references: [id])

  ticketFlags          TicketAsset[]
  solutions            Solution[]
  schedules            MaintenanceSchedule[]
  downtimeLogs         DowntimeLog[]
  usageLogs            AssetUsageLog[]
  productCapabilities  AssetProduct[]
  productChanges       ProductChangeLog[]
  productionPlanRows   ProductionPlanRow[]
  checklistAssignments AssetPmChecklistTemplate[]

  @@index([categoryId])
  @@index([status])
  @@index([parentAssetId])
  @@index([currentProductId])
}

// A reusable Preventive-Maintenance checklist prepared by the Maintenance
// Head/Supervisor, attachable to many machines (and a machine can carry many
// checklists — see AssetPmChecklistTemplate). Its items are snapshotted onto
// a PM ticket at creation (TicketChecklistResult) so later template edits
// never rewrite historical tickets.
model PmChecklistTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items            PmChecklistTemplateItem[]
  assetAssignments AssetPmChecklistTemplate[]
  tickets          Ticket[]
}

// Join table: which PM checklist templates apply to which assets (many-to-many).
model AssetPmChecklistTemplate {
  id         String   @id @default(uuid())
  assetId    String
  templateId String
  addedAt    DateTime @default(now())

  asset    Asset               @relation(fields: [assetId], references: [id])
  template PmChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([assetId, templateId])
  @@index([assetId])
  @@index([templateId])
}

model PmChecklistTemplateItem {
  id         String   @id @default(uuid())
  templateId String
  label      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template PmChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// Cumulative operating-hours readings — the data source for USAGE-based PM
// schedules. Manual entry to start (a small form on the asset page);
// swap in automated meter feeds later without touching the schema.
model AssetUsageLog {
  id           String   @id @default(uuid())
  assetId      String
  hoursReading Int // cumulative hours on the asset's meter at reading time
  recordedById String
  recordedAt   DateTime @default(now())

  asset      Asset @relation(fields: [assetId], references: [id])
  recordedBy User  @relation(fields: [recordedById], references: [id])

  @@index([assetId, recordedAt])
}

model ProblemType {
  id          String  @id @default(uuid())
  name        String  @unique // e.g. "Motor overheating", "Belt slippage"
  category    String?
  description String?

  tickets   Ticket[]
  solutions Solution[]
  schedules MaintenanceSchedule[]
}

// Knowledge base: curated fixes for a problem type (optionally scoped to one machine)
model Solution {
  id            String   @id @default(uuid())
  problemTypeId String
  assetId       String? // null = applies generally, set = asset-specific
  title         String
  description   String
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  problemType ProblemType @relation(fields: [problemTypeId], references: [id])
  asset       Asset?      @relation(fields: [assetId], references: [id])
  author      User        @relation(fields: [authorId], references: [id])
  tickets     Ticket[] // tickets created referencing this suggested solution
}

// Defines the SLA targets per priority — the source that fills in
// Ticket.ackDueAt / resolveDueAt at creation time. Editable by ADMIN/HEAD.
// e.g. CRITICAL: ack 15 min / resolve 4 h ... LOW: ack 8 h / resolve 5 days.
// (Business-hours calendars are a future refinement — clock time is fine to start.)
model SlaPolicy {
  id             String         @id @default(uuid())
  priority       TicketPriority @unique
  ackMinutes     Int // must be ASSIGNED within this
  resolveMinutes Int // must reach PENDING_VERIFICATION within this
  updatedAt      DateTime       @updatedAt
}

model Ticket {
  id                    String         @id @default(uuid())
  ticketNumber          String         @unique // e.g. "TKT-2026-0341" — sequence-backed, formatted at insert time
  title                 String
  description           String
  requesterId           String
  problemTypeId         String?
  suggestedSolutionId   String? // picked at creation time, if applicable
  priority              TicketPriority @default(MEDIUM)
  status                TicketStatus   @default(OPEN)
  type                  TicketType     @default(MAINTENANCE)
  source                TicketSource   @default(MANUAL)
  scheduleId            String? // set if source = PREVENTIVE
  holdReason            HoldReason? // set while ON_HOLD, cleared on resume
  reopenCount           Int            @default(0)
  productionPlanRowId   String? // set for MACHINE_SETUP tickets spun off a Production Plan row
  targetProductId       String? // the mold/product to switch the machine to on QA close (MACHINE_SETUP)
  pmChecklistTemplateId String? // which checklist the requester picked (PREVENTIVE_MAINTENANCE) — display pointer only; TicketChecklistResult is the actual snapshot

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ackDueAt     DateTime? // SLA target: must be assigned by this time (from SlaPolicy)
  resolveDueAt DateTime? // SLA target: must reach PENDING_VERIFICATION by this time (from SlaPolicy)
  slaBreached  Boolean   @default(false)
  startedAt    DateTime? // first time it entered IN_PROGRESS
  resolvedAt   DateTime? // tech marked done
  verifiedAt   DateTime? // requester confirmed
  closedAt     DateTime? // supervisor closed
  cancelledAt  DateTime?

  requester           User                 @relation("Requester", fields: [requesterId], references: [id])
  problemType         ProblemType?         @relation(fields: [problemTypeId], references: [id])
  suggestedSolution   Solution?            @relation(fields: [suggestedSolutionId], references: [id])
  schedule            MaintenanceSchedule? @relation(fields: [scheduleId], references: [id])
  productionPlanRow   ProductionPlanRow?   @relation(fields: [productionPlanRowId], references: [id])
  targetProduct       Product?             @relation("TicketTargetProduct", fields: [targetProductId], references: [id])
  pmChecklistTemplate PmChecklistTemplate? @relation(fields: [pmChecklistTemplateId], references: [id])

  remarks          TicketRemark[]
  attachments      TicketAttachment[]
  statusHistory    TicketStatusHistory[]
  assignments      TicketAssignment[]
  assets           TicketAsset[]
  partsUsed        TicketPart[]
  materialLogs     TicketMaterialLog[]
  checklistResults TicketChecklistResult[]
  downtimeLogs     DowntimeLog[]

  @@index([status])
  @@index([status, priority])
  @@index([type])
  @@index([createdAt])
  @@index([productionPlanRowId])
}

// Audit trail — also the source of truth for "time spent" reporting
model TicketStatusHistory {
  id          String        @id @default(uuid())
  ticketId    String
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById String
  note        String?
  createdAt   DateTime      @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id])
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([ticketId])
}

// Tracks each assign/reassign/halt event separately from status. Flat team
// of equals — no lead/primary technician: rows still open (unassignedAt
// IS NULL) are the sole source of truth for a ticket's current members.
// One-open-row-per-member is enforced by a hand-written partial unique
// index (see the flat_team_assignments migration), invisible to Prisma.
model TicketAssignment {
  id           String           @id @default(uuid())
  ticketId     String
  technicianId String
  assignedById String
  assignedAt   DateTime         @default(now())
  unassignedAt DateTime?
  reason       AssignmentReason @default(INITIAL_ASSIGN)

  ticket     Ticket @relation(fields: [ticketId], references: [id])
  technician User   @relation("AssignedTechnician", fields: [technicianId], references: [id])
  assignedBy User   @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([ticketId])
  @@index([technicianId])
}

// Which asset(s) a ticket is raised against. Mirrors TicketAssignment's flat
// pattern: rows still open (unflaggedAt IS NULL) are the sole source of
// truth for a ticket's current asset flags — a ticket is created against
// exactly one asset, then ADMIN/HEAD or an assigned technician can re-flag
// it to one or more. One-open-row-per-asset is enforced by a hand-written
// partial unique index (see the ticket_assets migration), invisible to Prisma.
model TicketAsset {
  id          String    @id @default(uuid())
  ticketId    String
  assetId     String
  flaggedById String
  flaggedAt   DateTime  @default(now())
  unflaggedAt DateTime?

  ticket    Ticket @relation(fields: [ticketId], references: [id])
  asset     Asset  @relation(fields: [assetId], references: [id])
  flaggedBy User   @relation(fields: [flaggedById], references: [id])

  @@index([ticketId])
  @@index([assetId])
}

model TicketRemark {
  id        String     @id @default(uuid())
  ticketId  String
  userId    String
  body      String
  type      RemarkType @default(WORK_LOG)
  createdAt DateTime   @default(now())

  ticket      Ticket             @relation(fields: [ticketId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  attachments TicketAttachment[]

  @@index([ticketId])
}

model TicketAttachment {
  id          String   @id @default(uuid())
  ticketId    String
  remarkId    String?
  storagePath String // path inside the PRIVATE Supabase Storage bucket — serve via short-lived signed URLs, never store a public URL
  fileName    String
  uploadedAt  DateTime @default(now())

  ticket Ticket        @relation(fields: [ticketId], references: [id])
  remark TicketRemark? @relation(fields: [remarkId], references: [id])

  @@index([ticketId])
}

// Preventive Maintenance: recurring rule that auto-generates a Ticket when due
model MaintenanceSchedule {
  id              String                @id @default(uuid())
  assetId         String
  problemTypeId   String? // e.g. "Scheduled lubrication"
  title           String
  frequencyType   ScheduleFrequencyType
  intervalDays    Int? // used when frequencyType = TIME
  intervalUsage   Int? // used when frequencyType = USAGE (e.g. every 500 hrs) — compared against AssetUsageLog readings
  lastGeneratedAt DateTime?
  nextDueAt       DateTime? // computed; drives the PM job
  defaultPriority TicketPriority        @default(MEDIUM)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  asset       Asset        @relation(fields: [assetId], references: [id])
  problemType ProblemType? @relation(fields: [problemTypeId], references: [id])
  tickets     Ticket[] // tickets this schedule has generated
}

// Actual asset downtime — separate from ticket status so MTBF/MTTR are accurate
// even when downtime starts before a ticket exists or outlasts the fix
model DowntimeLog {
  id         String    @id @default(uuid())
  assetId    String
  ticketId   String? // linked once a ticket is raised for it
  startedAt  DateTime
  endedAt    DateTime?
  reason     String?
  loggedById String

  asset    Asset   @relation(fields: [assetId], references: [id])
  ticket   Ticket? @relation(fields: [ticketId], references: [id])
  loggedBy User    @relation(fields: [loggedById], references: [id])

  @@index([assetId])
}

// Yearly-resetting atomic counter behind Ticket.ticketNumber. Only ever
// touched via raw INSERT ... ON CONFLICT ... RETURNING inside the
// ticket-create transaction — never through the regular Prisma API.
model TicketNumberCounter {
  year    Int @id
  counter Int
}

// Spare parts inventory
model Part {
  id             String   @id @default(uuid())
  sku            String   @unique
  name           String
  unit           String   @default("pcs") // pcs, liters, meters, etc.
  quantityOnHand Int      @default(0)
  reorderLevel   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  usages TicketPart[]
}

// Parts consumed on a specific ticket (technician logs this while resolving).
// Logging one must decrement Part.quantityOnHand in the same transaction,
// guarded so stock can't go negative under concurrency.
model TicketPart {
  id           String   @id @default(uuid())
  ticketId     String
  partId       String
  quantityUsed Int
  loggedById   String
  loggedAt     DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id])
  part     Part   @relation(fields: [partId], references: [id])
  loggedBy User   @relation(fields: [loggedById], references: [id])

  @@index([ticketId])
  @@index([partId])
}

// Free-text log of materials / spare parts consumed on a ticket. Available on
// every ticket type. Deliberately unstructured for now; a later phase upgrades
// this to draw from the Part inventory (nullable partId + stock decrement).
model TicketMaterialLog {
  id         String   @id @default(uuid())
  ticketId   String
  name       String
  quantity   String // free text, e.g. "2", "500 ml", "1 roll"
  unit       String?
  loggedById String
  loggedAt   DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id])
  loggedBy User   @relation(fields: [loggedById], references: [id])

  @@index([ticketId])
}

// Per-ticket snapshot of a PM checklist, copied from the machine's template at
// creation. A technician toggles each item done and adds a per-item remark.
model TicketChecklistResult {
  id          String    @id @default(uuid())
  ticketId    String
  label       String // snapshot of the template item's label
  sortOrder   Int       @default(0)
  done        Boolean   @default(false)
  remark      String?
  checkedById String?
  checkedAt   DateTime?

  ticket    Ticket @relation(fields: [ticketId], references: [id])
  checkedBy User?  @relation(fields: [checkedById], references: [id])

  @@index([ticketId])
}

// A Production Plan prepared by the Production team: a form-numbered document
// with a schedule window and effective date, carrying one row per Production
// Machine. Any one designated approver (ProductionPlanApprover) approves it,
// which freezes each row's "initial request" (approvedSnapshot) and lets
// Maintenance spin Machine-Setup tickets off individual rows. Post-approval
// row edits are tracked in ProductionPlanRowChange.
model ProductionPlan {
  id            String               @id @default(uuid())
  formNumber    String
  scheduleFrom  DateTime // production schedule window start
  scheduleTo    DateTime // production schedule window end
  effectiveDate DateTime
  status        ProductionPlanStatus @default(DRAFT)
  preparedById  String
  approvedById  String?
  approvedAt    DateTime?
  frozenAt      DateTime? // set at approval — when each row's approvedSnapshot was written
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  preparedBy User  @relation("PlanPreparedBy", fields: [preparedById], references: [id])
  approvedBy User? @relation("PlanApprovedBy", fields: [approvedById], references: [id])

  rows ProductionPlanRow[]

  @@index([status])
  @@index([preparedById])
}

// One row per Production Machine on a plan. `approvedSnapshot` is the frozen
// initial request written at approval; the live columns then diverge as
// post-approval edits are applied (each logged in ProductionPlanRowChange).
model ProductionPlanRow {
  id                 String   @id @default(uuid())
  planId             String
  assetId            String // the Production Machine this row concerns
  statusInstruction  String // "Status" — production's instruction for the machine
  productId          String? // Item Product to Produce — must be a capability of the asset
  referenceCycleTime String // free text
  remarks            String
  sortOrder          Int      @default(0)
  approvedSnapshot   Json? // frozen "initial request", written at approval time
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  plan    ProductionPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  asset   Asset                     @relation(fields: [assetId], references: [id])
  product Product?                  @relation(fields: [productId], references: [id])
  changes ProductionPlanRowChange[]
  tickets Ticket[]

  @@index([planId])
  @@index([assetId])
}

// Per-row change log for edits made after a plan is approved — the audit
// trail behind "mid-week changes tracked against the frozen initial request."
model ProductionPlanRowChange {
  id          String   @id @default(uuid())
  rowId       String
  changedById String
  changedAt   DateTime @default(now())
  field       String // which field changed, e.g. "statusInstruction", "productId"
  oldValue    String?
  newValue    String?

  row       ProductionPlanRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  changedBy User              @relation(fields: [changedById], references: [id])

  @@index([rowId])
}

// The managed set of users allowed to approve Production Plans. Any one of
// them approving a PENDING_APPROVAL plan deploys it.
model ProductionPlanApprover {
  userId  String   @id
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// In-app notification inbox. Append-only except `readAt`, which flips when the
// recipient opens it. `title`/`body`/`linkPath` are rendered at emit time so
// the bell and list never re-join the source row. Emitted inside the same
// transaction as the state change that triggers it (see lib/notifications.ts).
model Notification {
  id        String           @id @default(uuid())
  userId    String // recipient
  actorId   String? // who triggered it; null for system events
  type      NotificationType
  title     String
  body      String?
  linkPath  String? // in-app destination, e.g. /tickets/{id}
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
