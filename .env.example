# Copy to .env.local and fill in from your Supabase project (Settings → API / Database).
# All values without NEXT_PUBLIC_ stay server-side only.
# Placeholders are valid-format dummies so the app builds before Supabase is configured.

# Supabase project (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "Publishable key" (sb_publishable_...) — successor of the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
# Secret/service-role key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-KEY

# Postgres connection strings (Settings → Database)
# Runtime: transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations/CLI/seed: direct or session-pooler connection (port 5432)
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Base URL of this app; OAuth/email redirect URLs derive from it.
# Change when deploying (and add the new /auth/callback URL to Supabase's redirect allow-list).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails promoted to ADMIN/ACTIVE by `npm run db:seed`
# (each must sign in with Google once first, so the mirror row exists)
ADMIN_BOOTSTRAP_EMAILS=joyraymayol@gmail.com
